{% comment %}
  Sneaker Doctor dentro de cleanlab.pe.
  Pegar en Tienda online → Temas → Personalizar → plantilla de página "sneaker-doctor" → sección "Liquid personalizado".
  La página de Sneaker Doctor se muestra en un iframe aislado: sus estilos y su código no se mezclan con los del tema.
{% endcomment %}
<div class="sneaker-doctor page-width">
  <iframe
    id="sneaker-doctor-frame"
    src="https://sneaker-doctor-928770385966.us-central1.run.app/?embed=1"
    title="Sneaker Doctor: sube una foto de tu zapatilla y te decimos cómo limpiarla"
    sandbox="allow-scripts allow-same-origin allow-forms allow-top-navigation-by-user-activation"
    referrerpolicy="strict-origin-when-cross-origin"
    loading="eager"></iframe>
  <div class="sneaker-doctor__aviso" id="sneaker-doctor-aviso" role="status" hidden></div>
</div>

<style>
  .sneaker-doctor { margin-top: 1rem; margin-bottom: 3rem; }
  .sneaker-doctor iframe { display: block; width: 100%; height: 900px; border: 0; transition: height .15s ease; }
  .sneaker-doctor__aviso { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 50;
    background: #1B2E46; color: #fff; padding: 10px 16px; border-radius: 10px; font-size: 1.4rem;
    max-width: calc(100% - 32px); }
</style>

<script>
  (function () {
    var ORIGEN = "https://sneaker-doctor-928770385966.us-central1.run.app";
    var frame = document.getElementById("sneaker-doctor-frame");
    var aviso = document.getElementById("sneaker-doctor-aviso");
    var timer;
    window.addEventListener("message", function (e) {
      // Solo se aceptan mensajes del iframe de Sneaker Doctor
      if (e.origin !== ORIGEN || e.source !== frame.contentWindow || !e.data) return;
      if (e.data.tipo === "sneaker-doctor:alto") {
        var alto = Number(e.data.alto);
        if (alto > 300 && alto < 8000) frame.style.height = alto + "px";
      } else if (e.data.tipo === "sneaker-doctor:aviso") {
        aviso.textContent = String(e.data.texto || "").slice(0, 200);  // texto plano: nunca HTML
        aviso.hidden = false;
        clearTimeout(timer);
        timer = setTimeout(function () { aviso.hidden = true; }, 3500);
      }
    });
  })();
</script>
