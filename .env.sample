# Copiar a .env (local) o cargar como secrets (Streamlit Cloud / Cloud Run). Nunca subir al repositorio.

# Chat: gemini | groq | none
LLM_PROVIDER=gemini
# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Alternativa gratuita en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ruta del modelo (por defecto models/sneaker_doctor.keras)
# MODEL_PATH=models/sneaker_doctor.keras
